# Example Environment Variables for Heart Portal
# Copy this file to .env and configure with your actual values

# Shared secret key for session compatibility across all applications
SECRET_KEY=your-secret-key-here

# USDA API Key (for Nutrition Database)
# Get your key at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your-usda-api-key-here

# Flask environment
FLASK_DEBUG=0

# Reverse proxy mode for local development
REVERSE_PROXY_MODE=true

# Staging environment configuration
# Set STAGING_MODE=true only for staging deployments
STAGING_MODE=false
STAGING_BASE_URL=https://heartfailureportal.com:8082