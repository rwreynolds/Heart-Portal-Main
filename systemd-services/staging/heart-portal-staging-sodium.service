[Unit]
Description=Heart Portal Sodium Tracker (Staging with Venv)
After=network.target

[Service]
Type=simple
User=heartportal
WorkingDirectory=/opt/heart-portal-staging/Sodium-Tracker
Environment="PATH=/opt/heart-portal-staging/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/opt/heart-portal-staging"
Environment="FLASK_APP=app.py"
Environment="FLASK_PORT=5103"
ExecStart=/opt/heart-portal-staging/venv/bin/python app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
